# --- Required -----------------------------------------------------------------

# Public URL of your server (the hostname you set up in the Cloudflare Tunnel).
POD_PUBLIC_URL=https://pod.example.com

# Setup code needed to create a family on this server. Anyone with this code
# can create a family here, so keep it private. Generate one with:
#   openssl rand -base64 24
POD_SETUP_TOKEN=change-me-to-a-long-random-value

# Cloudflare Zero Trust -> Networks -> Tunnels -> Create tunnel -> copy the token.
# In the tunnel's "Public Hostname" tab point your hostname at: http://pod-server:8080
CLOUDFLARE_TUNNEL_TOKEN=

# --- Optional -----------------------------------------------------------------

# Longest location history a phone may ask the server to keep (days).
POD_MAX_HISTORY_DAYS=30

# Maximum phones per family.
POD_MAX_DEVICES=20

# Most a single phone may keep stored on the server, in MB (0 = unlimited).
POD_MAX_DEVICE_STORAGE_MB=200

# (POD_TRUST_CF_IP is set by docker-compose.yml for the Cloudflare Tunnel. Only set it to
#  true yourself if every request really comes through Cloudflare.)

# Log one line per API request (method, route, status, duration - never IPs or data).
POD_LOG_REQUESTS=true
