<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 29+: same dark theme, plus attributes that only exist on newer Android. -->
    <style name="Theme.Pod" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/pod_bg</item>
        <item name="android:colorBackground">@color/pod_bg</item>
        <item name="android:colorPrimary">@color/pod_accent</item>
        <item name="android:colorAccent">@color/pod_accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/pod_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
</resources>
