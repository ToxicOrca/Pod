# Copy to keystore.properties (same folder) and fill in. keystore.properties is gitignored.
# Use forward slashes in the path, even on Windows.
storeFile=C:/path/to/your/pod-release.jks
storePassword=CHANGE_ME
keyAlias=pod
keyPassword=CHANGE_ME

# Your app ID. Phones only accept updates with the same ID, so set it once and never change it.
# Leave both lines out to use the defaults (app.podfamily.location / .Launcher).
#applicationId=com.example.yourname.pod
#launcherName=.Launcher
